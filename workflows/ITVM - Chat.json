    {
      "parameters": {
        "jsCode": "// Cada asesor tiene su embudo: se busca la etapa de derivacion POR NOMBRE dentro del embudo del lead.\nconst cfg = $('Config ITVM').first().json;\nconst norm = v => String(v || '').trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst r = $('Resumen IA').first().json || {};\nconst resumen = String((r.choices && r.choices[0] && r.choices[0].message && r.choices[0].message.content) || 'Pidio hablar con un asesor (ver chat).').trim();\nconst etapas = (($input.first().json || {})._embedded || {}).statuses || [];\nconst etapa = etapas.find(e => norm(e.name) === norm(cfg.nombre_etapa_derivado));\nconst body = { tags_to_add: [{ name: cfg.tag_derivado }] };\nif (etapa) body.status_id = etapa.id;\nif (Number(cfg.campo_resumen_lead_id) > 0) body.custom_fields_values = [{ field_id: Number(cfg.campo_resumen_lead_id), values: [{ value: resumen }] }];\nreturn [{ json: { body, nota: 'Derivado por el asistente IA de ITVM\\n' + resumen } }];"
      },
