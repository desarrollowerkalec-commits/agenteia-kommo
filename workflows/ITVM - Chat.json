    {
      "parameters": {
        "jsCode": "const lead_id = Number($('Set Campos Mensaje').first().json.element_id) || null;\nlet output = String($json.output || '').trim();\n// El agente agrega [DERIVAR] al final cuando hay que pasar con un asesor: se quita antes de enviar.\nconst derivar = /\\[DERIVAR\\]/i.test(output);\noutput = output.replace(/\\[DERIVAR\\]/gi, '').trim();\nif (!output && derivar) output = 'Perfecto, un asesor de admisiones le va a contactar en breve.';\nif (!output) return [];\n// Kommo/WhatsApp no renderizan markdown de titulos ni negritas dobles.\noutput = output.replace(/\\*\\*(.+?)\\*\\*/g, '*$1*').replace(/^#+\\s*/gm, '');\nreturn [{ json: { output, lead_id, derivar } }];"
      },
