    {
      "parameters": {
        "jsCode": "const lead_id = Number($('Set Campos Mensaje').first().json.element_id) || null;\nlet output = String($json.output || '').trim();\nif (!output) return [];\n// Kommo/WhatsApp no renderizan markdown de titulos ni negritas dobles.\noutput = output.replace(/\\*\\*(.+?)\\*\\*/g, '*$1*').replace(/^#+\\s*/gm, '');\nreturn [{ json: { output, lead_id } }];"
      },
