{
  "name": "ITVM - Sync Documento",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6-22/2 * * *"
            }
          ]
        }
      },
      "id": "176af89d-8343-5255-a362-83dbcc777519",
      "name": "Cada 2 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://docs.google.com/document/d/ID_DEL_DOCUMENTO/export?format=txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "c310914e-bf01-5b20-adaf-bfbf93341031",
      "name": "Traer Documento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "let texto = String($input.first().json.data || '');\nif (/<html|<body/i.test(texto)) {\n  texto = texto\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<head[\\s\\S]*?<\\/head>/gi, '')\n    .replace(/<\\/(p|li|div|tr|h[1-6])>/gi, '\\n')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<[^>]+>/g, '');\n  const ent = { '&nbsp;': ' ', '&amp;': '&', '&quot;': '\"', '&#39;': \"'\", '&lt;': '<', '&gt;': '>',\n    '&aacute;': 'á', '&eacute;': 'é', '&iacute;': 'í', '&oacute;': 'ó', '&uacute;': 'ú', '&ntilde;': 'ñ',\n    '&Aacute;': 'Á', '&Eacute;': 'É', '&Iacute;': 'Í', '&Oacute;': 'Ó', '&Uacute;': 'Ú', '&Ntilde;': 'Ñ',\n    '&iquest;': '¿', '&iexcl;': '¡', '&mdash;': '—', '&ndash;': '–' };\n  for (const [k, v] of Object.entries(ent)) texto = texto.split(k).join(v);\n  texto = texto.replace(/&#(\\d+);/g, (m, c) => String.fromCodePoint(parseInt(c, 10)));\n  texto = texto.replace(/&#x([0-9a-f]+);/gi, (m, c) => String.fromCodePoint(parseInt(c, 16)));\n}\ntexto = texto.replace(/\\r\\n/g, '\\n').replace(/[ \\t]+\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nreturn [{ json: { texto, largo: texto.length } }];"
      },
      "id": "6c0317ea-0071-59a6-ab49-f411b090aba0",
      "name": "Extraer Texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.largo >= 100 && !/sign in|iniciar sesi[oó]n|accounts\\.google/i.test($json.texto.slice(0, 500)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b96fcffb-c570-566d-9d29-5fe1025ebcd9",
      "name": "Filter Texto Valido",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO crm.itvm_bot_config (id, notas_adicionales, actualizado_en)\nVALUES (1, $1, now())\nON CONFLICT (id) DO UPDATE SET notas_adicionales = EXCLUDED.notas_adicionales, actualizado_en = now();",
        "options": {
          "queryReplacement": "={{ [$json.texto] }}"
        }
      },
      "id": "4e56c16c-34cb-580f-9ddc-e2ffa2624218",
      "name": "Guardar Info",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM crm.itvm_buffer WHERE creado_en < now() - interval '7 days';\nDELETE FROM crm.itvm_processed_messages WHERE creado_en < now() - interval '30 days';",
        "options": {}
      },
      "id": "9cbf2479-e72a-561a-a5ac-efd87202b873",
      "name": "Limpiar Tablas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        520
      ]
    }
  ],
  "connections": {
