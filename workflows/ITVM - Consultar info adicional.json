    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT notas_adicionales, actualizado_en FROM crm.itvm_bot_config WHERE id = 1;",
        "options": {}
      },
      "id": "e2d8b931-0dc3-5fbc-99b4-4c3ea4c41fbf",
      "name": "Leer Info Adicional",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nconst texto = String(j.notas_adicionales || '').trim();\nif (!texto) {\n  return [{ json: { ok: false, nota: 'No hay informacion adicional cargada. No inventes precios ni fechas: ofrece que un asesor lo confirme.' } }];\n}\nreturn [{ json: { ok: true, actualizado_en: j.actualizado_en, informacion: texto.slice(0, 15000) } }];"
      },
      "id": "a77eae16-def8-565d-9cea-6f2bf9dd0610",
      "name": "Formatear Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
