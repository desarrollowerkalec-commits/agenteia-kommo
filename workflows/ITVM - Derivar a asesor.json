            {
              "name": "tag_derivado"
            }
          ]
        }
      },
      "id": "cb3b4d47-b1ac-5af9-aa84-666659daa620",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst limpio = v => String(v || '').trim();\nconst body = { tags_to_add: [{ name: limpio(i.tag_derivado) || 'ITVM-derivado' }] };\nconst status = Number(i.status_derivado_id) || 0;\nconst pipeline = Number(i.pipeline_id) || 0;\nif (status > 0) body.status_id = status;\nif (status > 0 && pipeline > 0) body.pipeline_id = pipeline;\nconst lineas = [\n  'Derivado por el asistente IA de ITVM',\n  limpio(i.nombre) && ('Nombre: ' + limpio(i.nombre)),\n  limpio(i.programa) && ('Programa: ' + limpio(i.programa)),\n  limpio(i.horario_preferido) && ('Horario preferido: ' + limpio(i.horario_preferido)),\n  limpio(i.financiamiento) && ('Financiamiento: ' + limpio(i.financiamiento)),\n  limpio(i.resumen) && ('Resumen:\\n' + limpio(i.resumen)),\n].filter(Boolean);\nconst base = limpio(i.kommo_base_url).replace(/\\/$/, '');\nreturn [{ json: { base, lead_id: limpio(i.lead_id), body, nota: lineas.join('\\n') } }];"
      },
      "id": "8f639b0e-d5dc-597f-bbd0-63e3dbbddc17",
      "name": "Armar Cambios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.base }}/api/v4/leads/{{ $json.lead_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "id": "cfa254f1-f508-59f8-8f66-fb4097706c49",
      "name": "Actualizar Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Armar Cambios').first().json.base }}/api/v4/leads/{{ $('Armar Cambios').first().json.lead_id }}/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ note_type: 'common', params: { text: $('Armar Cambios').first().json.nota } }]) }}"
      },
      "id": "98ecc585-3e1e-5863-9138-cd5b59eb33d2",
      "name": "Agregar Nota",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
