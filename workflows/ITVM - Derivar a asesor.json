{
  "name": "ITVM - Derivar a asesor",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "nombre"
            },
            {
              "name": "programa"
            },
            {
              "name": "horario_preferido"
            },
            {
              "name": "financiamiento"
            },
            {
              "name": "resumen"
            },
            {
              "name": "lead_id"
            },
            {
              "name": "kommo_base_url"
            },
            {
              "name": "status_derivado_id"
            },
            {
